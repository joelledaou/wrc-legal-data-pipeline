# Copy to .env before running docker compose. All pipeline configuration lives here.

# Host ports
MONGO_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DAGSTER_PORT=3000

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=wrc-secret
MONGO_URI=mongodb://root:wrc-secret@mongodb:27017/?authSource=admin
MONGO_DB=wrc
MONGO_LANDING_COLLECTION=decisions_landing
MONGO_PROCESSED_COLLECTION=decisions_processed

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_LANDING_BUCKET=wrc-landing
MINIO_PROCESSED_BUCKET=wrc-processed

# Source website
WRC_BASE_URL=https://www.workplacerelations.ie
WRC_SEARCH_PATH=/en/search/
WRC_RESULTS_PER_PAGE=10
# Comma-separated subset of: equality-tribunal, employment-appeals-tribunal,
# labour-court, workplace-relations-commission. Empty = all four.
WRC_BODIES=

# Partitioning: monthly | weekly | daily ---
PARTITION_SIZE=monthly

# Scraping behaviour
SCRAPER_USER_AGENT=wrc-legal-data-pipeline (assessment project)
SCRAPER_CONCURRENT_REQUESTS=8
SCRAPER_CONCURRENCY_PER_DOMAIN=4
SCRAPER_DOWNLOAD_DELAY=0.25
SCRAPER_AUTOTHROTTLE_MAX_DELAY=15
SCRAPER_RETRY_TIMES=3
SCRAPER_DOWNLOAD_TIMEOUT=60
SCRAPER_FORCE_REFETCH=false

# Logging
LOG_LEVEL=INFO
